{{!
    @template local_llmchat/interaction_freetext

    Fallback for unknown interaction kinds: the question and a free-text answer.

    Example context (json):
    {
        "uniqid": "llmchat-f-1",
        "question": "Bitte antworten:",
        "hasoptions": false
    }
}}
<div class="card local-llmchat-interaction" data-region="interaction">
    <div class="card-body">
        <p class="local-llmchat-question">{{question}}</p>
    <form class="input-group input-group-sm" data-region="freeform">
        <label class="sr-only visually-hidden" for="{{uniqid}}-text">{{#str}} answer, local_llmchat {{/str}}</label>
        <input type="text" class="form-control" id="{{uniqid}}-text" data-region="freetext"
            placeholder="{{#hasoptions}}{{#str}} other, local_llmchat {{/str}}{{/hasoptions}}{{^hasoptions}}{{#str}} typeanswer, local_llmchat {{/str}}{{/hasoptions}}">
        <div class="input-group-append">
            <button type="submit" class="btn btn-primary">{{#str}} answer, local_llmchat {{/str}}</button>
        </div>
    </form>
    </div>
</div>
