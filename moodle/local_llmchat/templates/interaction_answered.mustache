{{!
    @template local_llmchat/interaction_answered

    What replaces an interaction once it was answered.

    Example context (json):
    {
        "answer": "Termin und Bewertung"
    }
}}
<div class="small text-muted d-flex align-items-center local-llmchat-answered" data-region="interaction">
    <span class="text-success">{{#pix}} i/checked, core {{/pix}}</span><span>{{#str}} answered, local_llmchat {{/str}} <strong>{{answer}}</strong></span>
</div>
