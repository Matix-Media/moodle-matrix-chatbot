{{!
    @template local_llmchat/message_user

    One user message: a bubble on the right with the user's avatar.

    Example context (json):
    {
        "text": "Wann ist die Abgabe für das Subnetting-Projekt?",
        "avatar": "<img src=\"https://moodle.example/pix/u/f2.png\" class=\"userpicture\" alt=\"\">"
    }
}}
<div class="local-llmchat-msg local-llmchat-msg-user d-flex justify-content-end" data-role="user">
    <div class="local-llmchat-usercol d-flex flex-column align-items-end">
        <div class="local-llmchat-bubble">
            <span class="sr-only visually-hidden">{{#str}} you, local_llmchat {{/str}}:</span>
            <div class="local-llmchat-text" data-region="text">{{text}}</div>
        </div>
        <div class="small text-muted mt-1" data-region="note"></div>
    </div>
    <div class="local-llmchat-avatar ms-2 flex-shrink-0" aria-hidden="true">{{{avatar}}}</div>
</div>
