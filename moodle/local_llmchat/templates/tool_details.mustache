{{!
    @template local_llmchat/tool_details

    Expanded part of a tool card: the call's parameters as labelled rows (locations as breadcrumbs,
    lists as chips, patterns as code), a slot for the result, and the raw JSON behind a toggle.
    Rendered as a partial of local_llmchat/tool_call.

    Example context (json):
    {
        "uniqid": "llmchat-tool-1",
        "hasparams": true,
        "params": [
            {"label": "Search for", "istext": true, "text": "Abgabe Subnetting-Projekt"},
            {"label": "Location", "ispath": true, "arg": "path", "segments": [{"name": "LF7", "ref": "course:2", "last": false, "hasurl": false}, {"name": "Material Projekt", "ref": "section:7", "last": true, "hasurl": false}]},
            {"label": "Courses", "ischips": true, "chips": [{"text": "529"}, {"text": "530"}]},
            {"label": "Pattern", "iscode": true, "text": "\\b/2[4-9]"}
        ],
        "raw": "{\"query\": \"Abgabe Subnetting-Projekt\"}"
    }
}}
<div class="local-llmchat-tooldetails">
    {{#hasparams}}
    <h4 class="local-llmchat-label text-uppercase text-muted mb-1">{{#str}} tool:parameters, local_llmchat {{/str}}</h4>
    <dl class="local-llmchat-params">
        {{#params}}
        <div class="local-llmchat-param">
            <dt>{{label}}</dt>
            <dd>
                {{#istext}}{{text}}{{/istext}}
                {{#iscode}}<code>{{text}}</code>{{/iscode}}
                {{#ispath}}
                <div data-region="path" data-arg="{{arg}}">{{> local_llmchat/path_breadcrumb }}</div>
                {{/ispath}}
                {{#ischips}}
                <span class="d-inline-flex flex-wrap local-llmchat-chips">{{#chips}}<span class="badge badge-pill rounded-pill bg-light text-dark border">{{text}}</span>{{/chips}}</span>
                {{/ischips}}
            </dd>
        </div>
        {{/params}}
    </dl>
    {{/hasparams}}
    <div data-region="result">{{#result}}{{> local_llmchat/tool_result }}{{/result}}</div>
    <button type="button" class="btn btn-link btn-sm p-0 text-muted local-llmchat-toggle local-llmchat-rawtoggle" data-action="toggle"
        aria-expanded="false" aria-controls="{{uniqid}}-raw">
        <span class="local-llmchat-chevron">{{#pix}} t/expandedchevron, core {{/pix}}</span>{{#str}} tool:raw, local_llmchat {{/str}}
    </button>
    <div class="collapse" id="{{uniqid}}-raw">
        <pre class="small bg-light rounded p-2 mt-1 mb-0 local-llmchat-args">{{raw}}</pre>
    </div>
</div>
