{{!
    @template local_llmchat/notice

    Inline notice in a turn or the status area, styled like core/notification, with an optional action
    button (e.g. "Continue" after an interrupted turn) and optional spinner.

    Example context (json):
    {
        "type": "info",
        "icon": "i/info",
        "component": "core",
        "message": "The answer was interrupted.",
        "hasaction": true,
        "actionlabel": "Continue",
        "spinner": false
    }
}}
<div class="alert alert-{{type}} d-flex align-items-center local-llmchat-notice" role="status" data-region="notice">
    <span class="flex-shrink-0">{{#pix}} {{icon}}, {{component}} {{/pix}}</span>
    <span class="flex-grow-1">{{message}}</span>
    {{#spinner}}<span class="spinner-border spinner-border-sm ms-2 flex-shrink-0" aria-hidden="true"></span>{{/spinner}}
    {{#hasaction}}<button type="button" class="btn btn-primary btn-sm ms-3 flex-shrink-0" data-action="notice-action">{{actionlabel}}</button>{{/hasaction}}
</div>
