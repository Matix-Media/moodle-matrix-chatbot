{{!
    @template local_llmchat/path_breadcrumb

    A location (course, section, activity, file) as a breadcrumb. Segments the current user can
    open are links (resolved by id with local_llmchat_resolve_refs); the others stay plain text.

    Example context (json):
    {
        "segments": [
            {"name": "LF7", "ref": "course:2", "url": "https://moodle.example/course/view.php?id=2", "hasurl": true, "last": false},
            {"name": "Subnetting/Projekt", "ref": "section:7", "url": "https://moodle.example/course/section.php?id=7", "hasurl": true, "last": false},
            {"name": "Bewertungsraster.txt", "ref": "document:2:40:file:/Bewertungsraster.txt", "url": "", "hasurl": false, "last": true}
        ]
    }
}}
<ol class="breadcrumb local-llmchat-path">
    {{#segments}}
    <li class="breadcrumb-item{{#last}} active{{/last}}">{{#hasurl}}<a href="{{url}}" target="_blank" rel="noopener">{{name}}</a>{{/hasurl}}{{^hasurl}}{{name}}{{/hasurl}}</li>
    {{/segments}}
</ol>
