{{!
    @template local_llmchat/quota_panel

    Details behind the token ring in the chat header: one progress row per window, reset time,
    or a note for users without a personal limit.

    Example context (json):
    {
        "exempt": false,
        "rows": [
            {"label": "Today", "usedof": "23.410 of 50.000", "percent": 47, "warning": false, "danger": false},
            {"label": "This month", "usedof": "390.000 of 400.000", "percent": 98, "warning": true, "danger": false}
        ],
        "hasresets": true,
        "resets": "11.11.2026, 00:00"
    }
}}
<div class="local-llmchat-quotadetails">
    <h3 class="h6 mb-2">{{#str}} quota:title, local_llmchat {{/str}}</h3>
    {{#exempt}}
    <p class="small text-muted mb-0">{{#str}} quota:exemptuser, local_llmchat {{/str}}</p>
    {{/exempt}}
    {{^exempt}}
    {{#rows}}
    <div class="local-llmchat-quotarow">
        <div class="d-flex justify-content-between small">
            <span>{{label}}</span>
            <span class="text-muted">{{usedof}}</span>
        </div>
        <div class="progress local-llmchat-progress">
            <div class="progress-bar{{#warning}} bg-warning{{/warning}}{{#danger}} bg-danger{{/danger}}" role="progressbar"
                style="width: {{percent}}%" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{label}}"></div>
        </div>
    </div>
    {{/rows}}
    {{#hasresets}}
    <p class="small text-muted mb-0 mt-2">{{#str}} quota:resets, local_llmchat, {{resets}} {{/str}}</p>
    {{/hasresets}}
    {{/exempt}}
</div>
