{{!
    @template local_llmchat/interaction_choice

    Interaction kind "choice": pick one item from a list-group.

    Example context (json):
    {
        "question": "Welches Dokument meinst du?",
        "items": [
            {"id": "a", "label": "Aufgabenblatt.txt", "description": "Material Projekt"},
            {"id": "b", "label": "Bewertungsraster.txt", "description": ""}
        ]
    }
}}
<div class="card local-llmchat-interaction" data-region="interaction">
    <div class="card-body">
        <p class="local-llmchat-question">{{question}}</p>
        <div class="list-group">
            {{#items}}
            <button type="button" class="list-group-item list-group-item-action" data-action="choose" data-id="{{id}}">
                <span class="d-block">{{label}}</span>
                {{#description}}<span class="d-block small text-muted">{{description}}</span>{{/description}}
            </button>
            {{/items}}
        </div>
    </div>
</div>
