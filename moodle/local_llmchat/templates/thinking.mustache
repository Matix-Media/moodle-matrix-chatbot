{{!
    @template local_llmchat/thinking

    Collapsible reasoning block; expanded while the model thinks, collapsed once the answer starts.

    Example context (json):
    {
        "uniqid": "llmchat-thinking-1"
    }
}}
<div class="local-llmchat-thinking" data-region="thinking-block">
    <button type="button" class="btn btn-link btn-sm p-0 text-muted local-llmchat-toggle" data-action="toggle"
        aria-expanded="true" aria-controls="{{uniqid}}">
        <span class="local-llmchat-chevron">{{#pix}} t/expandedchevron, core {{/pix}}</span>{{#pix}} thinking, local_llmchat {{/pix}}<span data-region="label-active">{{#str}} thinking, local_llmchat {{/str}}</span><span class="d-none" data-region="label-done">{{#str}} thoughts, local_llmchat {{/str}}</span>
        <span class="spinner-border spinner-border-sm ms-1" data-region="spinner" aria-hidden="true"></span>
    </button>
    <div class="collapse show" id="{{uniqid}}" data-region="collapsible">
        <div class="small text-muted border-start border-left ps-3 pl-3 mt-1 local-llmchat-thinking-text" data-region="thinking-text"></div>
    </div>
</div>
