# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Moodle (needed from M1) ---
# Base URL of the Moodle site, no trailing slash, e.g. https://moodle.example-bs.de
BSBOT_MOODLE__BASE_URL=
BSBOT_MOODLE__USERNAME=
BSBOT_MOODLE__PASSWORD=
# Optional: paste a token directly to skip username/password login.
BSBOT_MOODLE__TOKEN=
# The Moodle web service to request a token for. moodle_mobile_app is the one
# the official app uses and is enabled on most sites.
BSBOT_MOODLE__SERVICE=moodle_mobile_app

# --- Google AI / Gemini (needed from M5) ---
BSBOT_GEMINI__API_KEY=
BSBOT_GEMINI__ANSWER_MODEL=gemini-3.5-flash-lite
BSBOT_GEMINI__UTILITY_MODEL=gemini-3.5-flash-lite
BSBOT_GEMINI__EMBED_MODEL=gemini-embedding-001
BSBOT_GEMINI__EMBED_DIM=768

# --- Matrix (needed from M7) ---
BSBOT_MATRIX__HOMESERVER=https://matrix.org
BSBOT_MATRIX__USER_ID=@yourbot:matrix.org
# Comma-separated room IDs the bot is allowed to act in, e.g. !abc:example.org
BSBOT_MATRIX__ROOM_IDS=

# Authenticate with EITHER an access token (preferred) OR a password.
#
# Access token: on matrix.org, accounts issued through next-gen auth (MAS/OIDC)
# reject m.login.password even though the flow is advertised, so a token is often
# the only route that works. In Element: Settings > Help & About > Advanced shows
# both the access token and the session ID (= device ID). DEVICE_ID is required
# for encrypted rooms, because message keys are bound to a device.
BSBOT_MATRIX__ACCESS_TOKEN=
BSBOT_MATRIX__DEVICE_ID=

# Password login (legacy accounts / self-hosted homeservers).
BSBOT_MATRIX__PASSWORD=
# Only if the login name is not the MXID localpart. Note: matrix.org does NOT
# accept e-mail addresses here; some self-hosted homeservers do.
BSBOT_MATRIX__LOGIN_IDENTIFIER=

# Per-user daily question quota (independent of the short-window flood limit).
BSBOT_MATRIX__RATE_LIMIT_PER_DAY=5
# Comma-separated MXIDs (e.g. teachers/moderators) exempt from all rate limits.
BSBOT_MATRIX__RATE_LIMIT_BYPASS_USERS=

# --- Storage ---
BSBOT_DATA_DIR=./data

# --- Sync schedule (used by `bsbot cron` / the `cron` service in docker-compose) ---
# Minutes between sync -> index -> embed cycles. School content changes over
# days, not minutes, so this defaults gently; lower it for a more active course.
BSBOT_SYNC_INTERVAL_MINUTES=180
