# Copy to .env and fill in. Every variable uses the MLC_ prefix; nested sections use "__".

# --- Chat model ------------------------------------------------------------
# provider: gemini | openai | ollama | anthropic
MLC_LLM__PROVIDER=gemini
MLC_LLM__MODEL=gemini-3.5-flash
# MLC_LLM__UTILITY_MODEL=gemini-3.5-flash-lite
MLC_LLM__API_KEY=
# OpenAI-compatible servers (vLLM, LM Studio) and Ollama: set the endpoint.
# MLC_LLM__BASE_URL=http://localhost:11434
# Thinking / reasoning: off | low | medium | high
MLC_LLM__THINKING=off
# MLC_LLM__THINKING_BUDGET_TOKENS=8000

# --- Embeddings (gemini | openai | ollama) -----------------------------------
MLC_EMBEDDING__PROVIDER=gemini
MLC_EMBEDDING__MODEL=gemini-embedding-001
MLC_EMBEDDING__DIM=768
MLC_EMBEDDING__API_KEY=
# OpenAI-compatible server (BASE_URL set) that can truncate vectors, e.g. OpenRouter
# or vLLM with a Matryoshka model such as Qwen3-Embedding: ask it for DIM dimensions.
# MLC_EMBEDDING__SEND_DIMENSIONS=true

# --- OCR for scanned PDF pages (uses the chat model's provider) ---------------
MLC_OCR__ENABLED=false

# --- Security ----------------------------------------------------------------
# Encryption at rest. Generate with `moodle-llm-chat gen-master-key`; prefer the file.
MLC_SECURITY__MASTER_KEY_FILE=/run/secrets/mlc_master_key

# --- Agent -------------------------------------------------------------------
MLC_AGENT__TIMEZONE=Europe/Berlin
# full | indicator | off — how much of the model's reasoning users see.
MLC_AGENT__SHOW_THINKING=indicator

MLC_LOG_LEVEL=INFO
