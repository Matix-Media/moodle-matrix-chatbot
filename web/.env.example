# Copy to .env for local `npm run dev` / `pnpm dev`. In docker-compose these
# are supplied by the `web` service's `environment:` block instead — see the
# root .env.example for BSBOT_WEB__API_TOKEN and CHAT_ACCESS_TOKEN.

# The public token end users must supply to use the chat.
NUXT_CHAT_ACCESS_TOKEN=

# The internal bsbot HTTP API (the `api` service in docker-compose).
NUXT_BSBOT_API_URL=http://localhost:8000
# Must match BSBOT_WEB__API_TOKEN in the root .env.
NUXT_BSBOT_API_TOKEN=
