# Model settings for the local dev stack. Copy to dev/.env and fill in.
# The stack sets data dir, master key and TLS itself (dev/docker-compose.yml).
# After changing anything here: docker compose -f dev/docker-compose.yml up -d api

# --- Chat model: gemini | openai | ollama | anthropic ---------------------------
MLC_LLM__PROVIDER=gemini
MLC_LLM__MODEL=gemini-3.5-flash
# MLC_LLM__UTILITY_MODEL=gemini-3.5-flash-lite
MLC_LLM__API_KEY=
# Thinking / reasoning: off | low | medium | high
MLC_LLM__THINKING=off

# --- Embeddings: gemini | openai | ollama --------------------------------------
# Changing model or dim after content was imported: the API refuses to start until
# the vectors are reset (content is kept and re-embedded in the background):
#   docker compose -f dev/docker-compose.yml run --rm --no-deps --entrypoint moodle-llm-chat api reembed --yes
#   docker compose -f dev/docker-compose.yml up -d
# OpenAI-compatible servers that ignore "dimensions" (LM Studio): set DIM to the
# model's native size, e.g. 1024 for text-embedding-qwen3-embedding-0.6b.
MLC_EMBEDDING__PROVIDER=gemini
MLC_EMBEDDING__MODEL=gemini-embedding-001
MLC_EMBEDDING__DIM=768
MLC_EMBEDDING__API_KEY=

# --- Examples -----------------------------------------------------------------
# OpenRouter for chat (any OpenAI-compatible endpoint works the same way; the model
# must support tool calling):
#   MLC_LLM__PROVIDER=openai
#   MLC_LLM__BASE_URL=https://openrouter.ai/api/v1
#   MLC_LLM__MODEL=google/gemma-4-31b-it:free
#   MLC_LLM__API_KEY=sk-or-...
#
# LM Studio embeddings on your machine:
#   MLC_EMBEDDING__PROVIDER=openai
#   MLC_EMBEDDING__BASE_URL=http://host.docker.internal:1234/v1
#   MLC_EMBEDDING__MODEL=text-embedding-qwen3-embedding-0.6b
#   MLC_EMBEDDING__DIM=1024
#   MLC_EMBEDDING__API_KEY=lm-studio
#
# Ollama (or LM Studio / vLLM via provider=openai) running on your machine:
#   MLC_LLM__PROVIDER=ollama
#   MLC_LLM__MODEL=qwen3:14b
#   MLC_LLM__BASE_URL=http://host.docker.internal:11434
#   MLC_EMBEDDING__PROVIDER=ollama
#   MLC_EMBEDDING__MODEL=nomic-embed-text
#   MLC_EMBEDDING__DIM=768
#   MLC_EMBEDDING__BASE_URL=http://host.docker.internal:11434
#
# Anthropic for chat (embeddings must come from another provider):
#   MLC_LLM__PROVIDER=anthropic
#   MLC_LLM__MODEL=claude-sonnet-5-5
#   MLC_LLM__API_KEY=sk-ant-...

MLC_OCR__ENABLED=false
MLC_AGENT__TIMEZONE=Europe/Berlin
# full | indicator | off — how much of the model's reasoning users see.
MLC_AGENT__SHOW_THINKING=full
MLC_LOG_LEVEL=DEBUG
